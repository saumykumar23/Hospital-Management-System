<mxfile host="app.diagrams.net">
  <diagram name="State Chart" id="hms-state">
    <mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="600" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="State Chart - Appointment Status Lifecycle" style="text;html=1;fontSize=18;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="250" y="10" width="500" height="30" as="geometry" />
        </mxCell>

        <!-- Start -->
        <mxCell id="start" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="60" y="240" width="30" height="30" as="geometry" />
        </mxCell>

        <!-- Requested -->
        <mxCell id="sRequested" value="Requested" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=40;" vertex="1" parent="1">
          <mxGeometry x="160" y="215" width="140" height="60" as="geometry" />
        </mxCell>

        <!-- Confirmed -->
        <mxCell id="sConfirmed" value="Confirmed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=40;" vertex="1" parent="1">
          <mxGeometry x="380" y="215" width="140" height="60" as="geometry" />
        </mxCell>

        <!-- In Progress -->
        <mxCell id="sInProgress" value="In progress" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=40;" vertex="1" parent="1">
          <mxGeometry x="600" y="215" width="140" height="60" as="geometry" />
        </mxCell>

        <!-- Completed -->
        <mxCell id="sCompleted" value="Completed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=40;" vertex="1" parent="1">
          <mxGeometry x="820" y="215" width="140" height="60" as="geometry" />
        </mxCell>

        <!-- Cancelled -->
        <mxCell id="sCancelled" value="Cancelled" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;arcSize=40;" vertex="1" parent="1">
          <mxGeometry x="380" y="380" width="140" height="60" as="geometry" />
        </mxCell>

        <!-- End -->
        <mxCell id="end" value="" style="shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="965" y="110" width="30" height="30" as="geometry" />
        </mxCell>

        <!-- Transitions -->
        <mxCell id="t1" style="endArrow=block;html=1;" edge="1" parent="1" source="start" target="sRequested">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="t2" value="payment confirmed" style="endArrow=block;html=1;fontSize=11;" edge="1" parent="1" source="sRequested" target="sConfirmed">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="t3" value="patient/receptionist cancels" style="endArrow=block;html=1;fontSize=11;dashed=1;" edge="1" parent="1" source="sRequested" target="sCancelled">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="t4" value="appointment time reached" style="endArrow=block;html=1;fontSize=11;" edge="1" parent="1" source="sConfirmed" target="sInProgress">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="t5" value="cancels before visit" style="endArrow=block;html=1;fontSize=11;dashed=1;" edge="1" parent="1" source="sConfirmed" target="sCancelled">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="450" y="330" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="t6" value="consultation done" style="endArrow=block;html=1;fontSize=11;" edge="1" parent="1" source="sInProgress" target="sCompleted">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="t7" style="endArrow=block;html=1;" edge="1" parent="1" source="sCompleted" target="end">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="t8" style="endArrow=block;html=1;" edge="1" parent="1" source="sCancelled" target="end">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="980" y="410" />
            </Array>
          </mxGeometry>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
