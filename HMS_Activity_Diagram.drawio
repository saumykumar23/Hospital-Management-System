<mxfile host="app.diagrams.net">
  <diagram name="Activity Diagram" id="hms-activity">
    <mxGraphModel dx="1000" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="1050" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Activity Diagram - Appointment Booking Process" style="text;html=1;fontSize=18;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="150" y="10" width="550" height="30" as="geometry" />
        </mxCell>

        <!-- Start node -->
        <mxCell id="start" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="385" y="60" width="30" height="30" as="geometry" />
        </mxCell>

        <!-- Activity 1 -->
        <mxCell id="a1" value="Patient submits appointment request" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="290" y="130" width="220" height="50" as="geometry" />
        </mxCell>

        <!-- Activity 2 -->
        <mxCell id="a2" value="Receptionist checks doctor availability" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="290" y="220" width="220" height="50" as="geometry" />
        </mxCell>

        <!-- Decision -->
        <mxCell id="d1" value="Slot available?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="320" y="310" width="160" height="80" as="geometry" />
        </mxCell>

        <!-- No branch: suggest alternate -->
        <mxCell id="aAlt" value="Suggest alternate date / time" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="60" y="330" width="200" height="50" as="geometry" />
        </mxCell>

        <!-- Yes branch: continue -->
        <mxCell id="a3" value="Confirm appointment" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="290" y="440" width="220" height="50" as="geometry" />
        </mxCell>

        <mxCell id="a4" value="Generate bill" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="290" y="530" width="220" height="50" as="geometry" />
        </mxCell>

        <mxCell id="a5" value="Patient makes payment" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="290" y="620" width="220" height="50" as="geometry" />
        </mxCell>

        <mxCell id="a6" value="Send confirmation to patient" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="290" y="710" width="220" height="50" as="geometry" />
        </mxCell>

        <!-- End node -->
        <mxCell id="end" value="" style="shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="385" y="800" width="30" height="30" as="geometry" />
        </mxCell>

        <!-- Flow arrows -->
        <mxCell id="e1" style="endArrow=block;html=1;" edge="1" parent="1" source="start" target="a1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" style="endArrow=block;html=1;" edge="1" parent="1" source="a1" target="a2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" style="endArrow=block;html=1;" edge="1" parent="1" source="a2" target="d1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="Yes" style="endArrow=block;html=1;fontSize=11;" edge="1" parent="1" source="d1" target="a3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" value="No" style="endArrow=block;html=1;fontSize=11;" edge="1" parent="1" source="d1" target="aAlt">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" style="endArrow=block;html=1;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="aAlt" target="a2">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="30" y="245" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e7" style="endArrow=block;html=1;" edge="1" parent="1" source="a3" target="a4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e8" style="endArrow=block;html=1;" edge="1" parent="1" source="a4" target="a5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e9" style="endArrow=block;html=1;" edge="1" parent="1" source="a5" target="a6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e10" style="endArrow=block;html=1;" edge="1" parent="1" source="a6" target="end">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
