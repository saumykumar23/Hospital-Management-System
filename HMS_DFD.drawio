<mxfile host="app.diagrams.net">
  <diagram name="DFD Level 0" id="hms-dfd0">
    <mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="650" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="DFD Level 0 - Context Diagram" style="text;html=1;fontSize=18;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="250" y="10" width="400" height="30" as="geometry" />
        </mxCell>

        <!-- Central process -->
        <mxCell id="proc0" value="0&#10;Hospital Management System" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;arcSize=20;" vertex="1" parent="1">
          <mxGeometry x="330" y="250" width="220" height="100" as="geometry" />
        </mxCell>

        <!-- External entities -->
        <mxCell id="entPatient" value="Patient" style="whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="60" y="60" width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="entDoctor" value="Doctor" style="whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="680" y="60" width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="entReceptionist" value="Receptionist" style="whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="60" y="500" width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="entAdmin" value="Admin" style="whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="680" y="500" width="140" height="60" as="geometry" />
        </mxCell>

        <!-- Flows -->
        <mxCell id="f1" value="Appointment request, payment" style="endArrow=block;html=1;fontSize=10;" edge="1" parent="1" source="entPatient" target="proc0">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f2" value="Confirmation, bill" style="endArrow=block;html=1;fontSize=10;" edge="1" parent="1" source="proc0" target="entPatient">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f3" value="Diagnosis, prescription" style="endArrow=block;html=1;fontSize=10;" edge="1" parent="1" source="entDoctor" target="proc0">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f4" value="Patient medical history" style="endArrow=block;html=1;fontSize=10;" edge="1" parent="1" source="proc0" target="entDoctor">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f5" value="Registration, billing info" style="endArrow=block;html=1;fontSize=10;" edge="1" parent="1" source="entReceptionist" target="proc0">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f6" value="Patient records, schedules" style="endArrow=block;html=1;fontSize=10;" edge="1" parent="1" source="proc0" target="entReceptionist">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f7" value="Staff management commands" style="endArrow=block;html=1;fontSize=10;" edge="1" parent="1" source="entAdmin" target="proc0">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f8" value="Reports, staff data" style="endArrow=block;html=1;fontSize=10;" edge="1" parent="1" source="proc0" target="entAdmin">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
